# VEKTORFLOW-15 Universal E-Commerce Configuration
# Works with ANY platform: Shopify, WooCommerce, BigCommerce, Magento, Wix, Squarespace, Custom API

VEKTORFLOW_API_KEY=your_generated_api_key_here

# Choose your platform:
# shopify | woocommerce | bigcommerce | magento | wix | squarespace | custom
ECOMMERCE_PLATFORM=your_platform_here

# Your store URL
STORE_URL=your-store.com

# API credentials (format depends on your platform)
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
ACCESS_TOKEN=your_access_token_here

PORT=8000
